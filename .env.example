# Required. Your Anthropic API key, used by /api/ask on the server only.
ANTHROPIC_API_KEY=

# Convex. `npx convex dev` writes these into .env.local.
# With NEXT_PUBLIC_CONVEX_URL set, accounts are on and boards sync to Convex.
NEXT_PUBLIC_CONVEX_URL=
# Optional. Convex CLI uses this to pick the deployment. Written by `npx convex dev`.
CONVEX_DEPLOYMENT=

# Only used when Convex is NOT configured: gates /api/ask on Vercel.
APP_PASSCODE=

# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Convex dashboard / `npx convex env set` (not Next.js). Required for Convex Auth:
#   SITE_URL              http://localhost:3000 locally, your Vercel URL in production
#   JWT_PRIVATE_KEY       from `npm run auth:keys`
#   JWKS                  from `npm run auth:keys`
# Optional, for Google sign-in:
#   AUTH_GOOGLE_ID
#   AUTH_GOOGLE_SECRET
# Vercel production deploy (build command `npx convex deploy --cmd 'npm run build'`):
#   CONVEX_DEPLOY_KEY
