# Required. Your Anthropic API key, used by /api/ask on the server only.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Convex. From `npx convex dev` / the Convex dashboard.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set on the Convex deployment (`npx convex env set`), not only in this file:
# BETTER_AUTH_SECRET — openssl rand -base64 32
# SITE_URL — e.g. http://localhost:3000
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET — optional, enables Google sign-in
