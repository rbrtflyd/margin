# Required. Your Anthropic API key, used by /api/ask on the server only.
ANTHROPIC_API_KEY=

# Neon Auth (managed Better Auth). Both set = accounts on, everything requires sign-in.
# Base URL: Neon Console > your project > Branch > Auth > Configuration.
NEON_AUTH_BASE_URL=
# At least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Only used when Neon Auth is NOT configured: gates /api/ask on Vercel.
APP_PASSCODE=

# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
